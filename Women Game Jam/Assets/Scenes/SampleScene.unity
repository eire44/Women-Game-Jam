  m_Script: {fileID: 11500000, guid: c6ec08c55ee7c2f4b9aa69810f3c0fe8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FormsController
  preguntasForms:
  - pregunta: "Empecemos por lo general, preferir\xEDas que tu pareja ideal fuera:"
    respuesta1: hombre
    respuesta2: mujer
    respuesta1_Imagen: {fileID: 21300000, guid: fbeed5cc774152e47844dc01a0377dc3, type: 3}
    respuesta2_Imagen: {fileID: 21300000, guid: 0b122f87b3b680b4ca8aa3bcc126b13a, type: 3}
  - pregunta: "Se acerca el fin de semana, te gustar\xEDa m\xE1s una escapada a la:"
    respuesta1: playa
    respuesta2: "monta\xF1a"
    respuesta1_Imagen: {fileID: 21300000, guid: 99535dadb100db243b5d01ca850e823e, type: 3}
    respuesta2_Imagen: {fileID: 21300000, guid: bbc123ae473754f4781e8df6c4c88357, type: 3}
  - pregunta: "Tu mascota ideal ser\xEDa un:"
    respuesta1: perro
    respuesta2: gato
    respuesta1_Imagen: {fileID: 21300000, guid: 8286c18002b26c14f96230edc782d3ff, type: 3}
    respuesta2_Imagen: {fileID: 21300000, guid: feb07b9345d964d40906f8b795670f46, type: 3}
  - pregunta: "Quer\xE9s compartir tiempo de calidad con tu pareja, \xBFQu\xE9 te
      imagin\xE1s tomando?"
    respuesta1: cafe
    respuesta2: cerveza
    respuesta1_Imagen: {fileID: 21300000, guid: f74dbbb8e609b8040bc4fc1c5eccdb7c, type: 3}
    respuesta2_Imagen: {fileID: 21300000, guid: bcce4af2c152a4d418e25b22f3cc7358, type: 3}
  txtPregunta: {fileID: 1260769023}
  txtRespuesta1: {fileID: 1668812733}
